+
+.pdf-preview,
+.pdf-toolbar,
+.diag-panel,
+.pdf-annotations,
+.log-content,
+.file-tree-body,
+.editor-area {
+  border-color: var(--maziar-line);
+}
+
+.pdf-preview,
+.pdf-toolbar,
+.diag-panel {
+  border-width: 1.5px;
+}
+
+.diag-list,
+.panel-header,
+.breadcrumb-bar,
+.editor-toolbar {
+  border-color: var(--maziar-line) !important;
+}
+
+/* The editor's text area gets its own frame, separate from the toolbar above it. */
+.editor-area {
+  border-top: 1.5px solid var(--maziar-line);
+}
+
+/* Maziar: "%%%" comments — bold green notes (the inner span overrides the normal comment colour). */
