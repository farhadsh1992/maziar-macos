+const FILE_OPEN = /^\(([^\s()]+?\.(?:tex|ltx|sty|cls|clo|cfg|def|fd|aux|toc|lof|lot|bbl|out|ldf|dict|code\.tex|bib|nav|snm|vrb|ins|dtx))(?=[\s()]|$)/;
+
+function normalizeFile(raw: string) {
+  let name = raw.trim();
+  while (name.startsWith('./')) name = name.slice(2);
+  return name;
+}
