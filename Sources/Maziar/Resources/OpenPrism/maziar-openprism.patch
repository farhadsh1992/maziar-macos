+/* ---------- Maziar: light-blue borders so panels, dividers and text fields stand out ---------- */
+
+:root {
+  --maziar-line: #8ec3f0;
+  --maziar-line-strong: #4f9fe3;
+  --maziar-line-soft: rgba(142, 195, 240, 0.55);
+  --border: var(--maziar-line);
+}
+
+/* Maziar's dark mode inverts the page (keeping hues), so a darker blue there shows as a soft light blue. */
