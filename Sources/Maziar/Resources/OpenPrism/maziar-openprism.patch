+  --maziar-line: #2d6eae;
+  --maziar-line-strong: #1b5592;
+  --maziar-line-soft: rgba(45, 110, 174, 0.6);
+}
+
+.panel {
+  border: 1.5px solid var(--maziar-line);
+}
+
+.drag-handle {
+  background: var(--maziar-line-soft);
+}
+
+.drag-handle:hover,
+.drag-handle:active {
+  background: var(--maziar-line-strong);
+}
+
+.input,
+textarea.input,
+.chat-input,
+.vision-result textarea,
+.ios-select-trigger,
+.spell-lang,
+.inline-input,
+.editor-host .cm-search.cm-panel input[type="text"] {
+  border-color: var(--maziar-line) !important;
+}
+
+.input:focus,
+textarea.input:focus,
+.chat-input:focus,
+.inline-input:focus,
